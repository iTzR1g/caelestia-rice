{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "display": {
        "separator": " → ",
        "color": "white",
        "constants": ["\u001b[38;2;23;147;209m", "\u001b[38;2;205;214;244m"]
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "{$1} {$1}OS{$2}"
        },
        {
            "type": "host",
            "key": "{$1}󰌢 {$1}Host{$2}"
        },
        {
            "type": "kernel",
            "key": "{$1} {$1}Kernel{$2}"
        },
        {
            "type": "uptime",
            "key": "{$1} {$1}Uptime{$2}"
        },
        {
            "type": "packages",
            "key": "{$1} {$1}Packages{$2}"
        },
        {
            "type": "shell",
            "key": "{$1} {$1}Shell{$2}"
        },
        {
            "type": "de",
            "key": "{$1} {$1}DE{$2}"
        },
        {
            "type": "wm",
            "key": "{$1} {$1}WM{$2}"
        },
        {
            "type": "terminal",
            "key": "{$1} {$1}Terminal{$2}"
        },
        {
            "type": "terminalfont",
            "key": "{$1} {$1}Font{$2}"
        },
        {
            "type": "cpu",
            "key": "{$1} {$1}CPU{$2}"
        },
        {
            "type": "gpu",
            "key": "{$1}󰍹 {$1}GPU{$2}"
        },
        {
            "type": "memory",
            "key": "{$1} {$1}Memory{$2}"
        },
        {
            "type": "disk",
            "key": "{$1} {$1}Disk{$2}"
        },
        "break",
        "colors"
    ]
}
